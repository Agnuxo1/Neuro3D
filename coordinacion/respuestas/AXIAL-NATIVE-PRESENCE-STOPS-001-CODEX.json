  "independent_validator_code": "import base64,hashlib,json,struct,zlib\nfrom copy import deepcopy\nfrom fractions import Fraction\nfrom pathlib import Path\nROOT=Path.cwd();r=json.loads((ROOT/'coordinacion/respuestas/AXIAL-NATIVE-PRESENCE-STOPS-001-CODEX.json').read_bytes())\ndef need(x,m):\n    if not x:raise AssertionError(m)\ndef digest(x):return hashlib.sha256(x).hexdigest()\ndef canon(x):return json.dumps(x,sort_keys=True,separators=(',',':'),allow_nan=False).encode()\ndef payload(report):\n    t=report['test_run'];raw=zlib.decompress(base64.b64decode(t.get('stdout_zlib_base64') or ''.join(t['stdout_zlib_base64_chunks']),validate=True))\n    need(t['rc']==0 and len(raw)==t['stdout_bytes'] and digest(raw)==t['stdout_sha256'],'raw receipt')\n    return json.loads(raw)\ndep=r['inherited_pin_source'];raw=(ROOT/dep['path']).read_bytes();need(digest(raw)==dep['sha256'],'previous receipt')\nprevious=json.loads(raw);pins=dict(previous['code_doc_sha256']);pins[dep['path']]=dep['sha256']\nfor p,h in dict(pins,**r['own_code_doc_sha256']).items():need(digest((ROOT/p).read_bytes())==h,'pin '+p)\nbody=payload(r);need(body['PASS'] and body['tests']==5 and body['pins']==pins,'suite pins')\npackets=payload(json.loads((ROOT/'coordinacion/respuestas/AXIAL-NATIVE-INGRESS-001-CODEX.json').read_bytes()))['packets']\nfrozen=payload(previous)['cases']\ndef replace(p,k,b):\n    p['buffers_base64'][k]=base64.b64encode(b).decode()\n    p['manifest']['buffers'][k]={'bytes':len(b),'sha256':digest(b)}\ndef integer(w):\n    need(type(w) is list and len(w)==16 and all(type(x) is int and 0<=x<2**32 for x in w),'words')\n    v=sum(x<<(32*i) for i,x in enumerate(w));return v-2**512 if v>=2**511 else v\ndef remap(x,old,new):\n    if type(x) is str:return new if x==old else x\n    if type(x) is dict:return {k:remap(v,old,new) for k,v in x.items()}\n    if type(x) is list:return [remap(v,old,new) for v in x]\n    return x\nexpected={\n 'missing_cap_one':('positive',True,False),\n 'missing_cap_two_sources':('two_sources',True,False),\n 'missing_HOST_reference':('positive',False,True),\n 'missing_both':('positive',True,True)}\nneed(set(body['synthetic_controls'])==set(expected),'four changed controls only')\nstops=phasepass=geometry=refs=corners=bytes_extra=caps_present=caps_absent=0\nfor label,(name,missing_cap,missing_ref) in expected.items():\n    c=body['synthetic_controls'][label];oldpacket=packets[name];p=deepcopy(oldpacket)\n    metadata=json.loads(base64.b64decode(p['buffers_base64']['input_metadata_json']))\n    if missing_cap:metadata['original_path_phase_caps']['s']=None\n    if missing_ref:\n        metadata['reference']['HOST_reference_ABI']=None\n        rw=list(struct.unpack('<31I',base64.b64decode(p['buffers_base64']['reference'])))\n        replace(p,'reference',struct.pack('<13I',0,*rw[1:13]))\n        p['manifest']['layout']['reference']={'HOST_encoding_available':False,'words':13}\n    replace(p,'input_metadata_json',canon(metadata))\n    need(c['parent']==p and c['case_name']==name and c['missing_cap_s'] is missing_cap and c['missing_HOST_reference'] is missing_ref,'only declared delta')\n    out=c['result'];overlay=c['overlay'];newsha=digest(canon(p));oldsha=digest(canon(oldpacket))\n    need(out['input_packet_sha256']==newsha and out['overlay_sha256']==digest(canon(overlay)),'same synthetic receipts')\n    for k in ('scene_binding_sha256','word_ABI_sha256','source_order','reference_frame'):need(out[k]==frozen[name][k],'same original scene/'+k)\n    need(out['HOST_reference_available'] is (not missing_ref) and overlay['HOST_reference_availability_preserved'] is (not missing_ref),'HOST absence')\n    need(overlay['cap_records_available']==sum(cap is not None for cap in metadata['original_path_phase_caps'].values()),'present counts')\n    need(overlay['cap_records_absent']==sum(cap is None for cap in metadata['original_path_phase_caps'].values()),'absent counts')\n    caps_present+=overlay['cap_records_available'];caps_absent+=overlay['cap_records_absent']\n    original=json.loads(base64.b64decode(p['buffers_base64']['original_scene_json']))\n    vals=[original['objects']['M']['vertices_world_BU'][0][0],original['objects']['D']['vertices_world_BU'][0][0],\n          original['objects']['D']['mode_origin_BU'][0],original['lambda_BU']]+[s['position_BU'][0] for s in original['sources']]\n    axes=b''.join(struct.pack('<d',x) for x in vals);caprecords=[]\n    for sid in out['source_order']:\n        cap=metadata['original_path_phase_caps'][sid]\n        caprecords.append(bytes(132) if cap is None else struct.pack('<I',1)+cap[0].to_bytes(64,'little')+cap[1].to_bytes(64,'little'))\n    for k,b in (('original64_axes',axes),('original_rational_caps',b''.join(caprecords))):\n        need(base64.b64decode(overlay['buffers_base64'][k],validate=True)==b,'INPUT bits/rational absence/'+k)\n        need(overlay['buffer_receipts'][k]=={'bytes':len(b),'sha256':digest(b)},'overlay receipt')\n        bytes_extra+=len(b)\n    prior={x['source_id']:x for x in frozen[name]['sources']}\n    for row,inp in zip(out['sources'],out['HOST_original_inputs']['sources']):\n        sid=row['source_id'];before=row['reference'];old=prior[sid]\n        need(before['geometry']==remap(old['reference']['geometry'],oldsha,newsha),'fresh geometry unchanged except caller receipt')\n        need(before['geometry']['accepted_axial_two_event_geometry_CPU_only'] is True,'valid geometry');geometry+=1\n        for k in ('source_phase_reference_id','terminal_reference_id'):need(before[k]==old['reference'][k],'gauges unchanged')\n        cap=metadata['original_path_phase_caps'][sid];present=cap is not None;refready=not missing_ref\n        need(before['original_phase_budget_rad']==cap,'actual cap None vs 0')\n        need(before['reference_bounds_evaluated_CPU_only'] is refready,'reference ready');refs+=refready\n        need(row['phase_bound_predicate_evaluated_CPU_only'] is (present and refready),'phase ready by presence')\n        need(row['accepted_reference_phase_bound_CPU_only'] is (present and refready),'expected gate')\n        if not present:need(inp['original_phase_cap'] is None,'no numeric zero')\n        else:need([integer(inp['original_phase_cap'][k]) for k in ('numerator_words','denominator_words')]==cap,'exact remaining cap')\n        if not refready:\n            need(row['reason']=='HOST reference absent; no new encoder or default reference','ref STOP precedence')\n            need('effective_reference_length_interval_words' not in before,'no fake reference')\n        elif not present:\n            need(row['reason']=='original phase cap absent; no numerical zero default','cap STOP')\n            for k in ('effective_reference_length_interval_words','wavelength_interval_words'):\n                need(before[k]==old['reference'][k],'same valid enclosures')\n        if not present or not refready:\n            need('corners' not in row and 'original_effective_reference_length_words' not in row,'no manufactured phase arguments')\n            stops+=1\n        else:\n            need(sid=='other' and cap==[0,1] and row['corners']==old['corners'],'other source retained exactly')\n            phasepass+=1;corners+=len(row['corners'])\n        need(row['phase_unit_evaluated'] is False and row['accepted_full_field_pipeline'] is False,'no field')\n    need(out['HOST_original_inputs']['original_R_X_words']==frozen[name]['HOST_original_inputs']['original_R_X_words'],'original R transport must not revive HOST ref')\n    for key in ('phase_unit_evaluated','accepted_full_field_pipeline','accepted_complete_geometry','GLSL_compiled','GPU_executed','GPU_job_admission','execution_authenticated','accepted_reference_phase_bound_CPU_only','phase_bound_predicate_evaluated_CPU_only'):\n        need(out[key] is False,'no aggregate promotion/'+key)\n    need(overlay['new_HOST_RN32_encodings']==overlay['new_HOST_RN64_subtractions']==0,'no hi-lo encoder')\nneed((geometry,refs,phasepass,stops,corners,bytes_extra,caps_present,caps_absent)==(5,3,1,4,4,828,2,3),'counts')\nneed(len(body['corner_calls'])==4,'ONLY four corners of other source')\nfor call in body['corner_calls']:\n    e,w,o,wo,p,q=map(integer,call['inputs']);need(w>0 and wo>0 and p==0 and q==1,'corner inputs')\n    diff=abs(e*wo-o*w);den=w*wo;out=call['result']\n    for k,value in (('cycle_difference_numerator_words',diff),('cycle_difference_denominator_words',den),('cross_left_words',8*diff*q),('cross_right_words',p*den)):\n        need(integer(out[k])==value,'independent corner')\n    need(out['bound_predicate_PASS'] is (8*Fraction(diff,den)<=Fraction(p,q)),'independent predicate')\nprint(json.dumps({'PASS':True,'pins':len(pins)+len(r['own_code_doc_sha256']),'inherited_pins':len(pins),\n 'synthetic_inputs':4,'sources':5,'valid_geometry':geometry,'valid_reference':refs,'remaining_source_phase_PASS':phasepass,\n 'presence_STOP':stops,'evaluated_corners':corners,'HOST_overlay_input_bytes':bytes_extra,'available_caps':caps_present,'absent_caps':caps_absent,\n 'core_and_frozen_unchanged':True,'GPU_executed':False,'accepted_full_field_pipeline':False},sort_keys=True))\n",
