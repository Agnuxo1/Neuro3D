  "independent_validation": {
    "source": "import base64,hashlib,json,pathlib,zlib\nfrom fractions import Fraction as F\nR=pathlib.Path.cwd();S=1<<149\ndef sha(b):return hashlib.sha256(b).hexdigest()\ndef digest(v):return sha(json.dumps(v,sort_keys=True,separators=(',',':'),allow_nan=False).encode())\ndef q(p):return F(*p)\ndef number(w,domain=True):\n    assert type(w) is int and 0<=w<1<<32\n    e=(w>>23)&255;m=w&0x7fffff;assert e!=255\n    if domain:assert e!=0 or m==0\n    sign=-1 if w>>31 else 1\n    return sign*F(m,1<<149) if e==0 else sign*F((1<<23)+m)*F(2)**(e-150)\ndef nearest(w,x):\n    v=number(w)\n    candidates=[t for t in (w-1,w,w+1,0,0x80000000) if 0<=t<1<<32 and (t>>23)&255!=255]\n    winner=min(candidates,key=lambda t:(abs(number(t,False)-x),t&1,t))\n    assert w==winner,(w,winner)\n    return v\ndef integer(words,bits):\n    assert len(words)==bits//32 and all(type(w) is int and 0<=w<1<<32 for w in words)\n    n=sum(w<<(32*i) for i,w in enumerate(words))\n    return n-(1<<bits) if words[-1]>>31 else n\ndef payload(run):\n    b=zlib.decompress(base64.b64decode(run['stdout_zlib_base64'],validate=True))\n    assert len(b)==run['stdout_bytes'] and sha(b)==run['stdout_sha256']\n    return json.loads(b)\ndef validate(r):\n    for n,h in r['code_doc_sha256'].items():assert sha((R/n).read_bytes())==h,n\n    p=r['previous_report'];raw=(R/p['path']).read_bytes();assert sha(raw)==p['sha256']\n    previous=json.loads(raw);old=payload(previous['test_run'])['cases'];run=r['test_run']\n    assert run['rc']==0 and 'Ran 8 tests' in run['stderr'] and 'OK' in run['stderr']\n    data=payload(run);a=data['audit'];assert a['bridge_model']==r['model']\n    assert a['pins_verified']==dict(previous['code_doc_sha256'],**{p['path']:p['sha256']})\n    assert len(a['pins_verified'])==94 and len(r['code_doc_sha256'])==97\n    flags=('GPU_executed','ALU_executed','native_geometry_implemented','native_selector_implemented','execution_authenticated','accepted_full_field_pipeline','field_values_computed','native_promotion_allowed','geometry_or_producer_rerun')\n    assert all(a[f] is False for f in flags)\n    assert list(a['cases'])==list(old) and len(old)==13\n    count={'cases':13,'sources':0,'new_length_integer_nodes':0,'HOST_length_RN32_nodes':0,'quotient_RN32_nodes':0,'selector_integer_nodes':0,'original_source_phase_oracles':0,'geometry_stops':0,'bridge_accepted_sources':0,'bridge_accepted_cases':0,'retained_geometry_nodes_NOT_executed':0,'frozen_pins':94,'code_doc_fingerprints':97}\n    for name,c in a['cases'].items():\n        gcase=old[name];b=gcase['word_ABI'];scene=gcase['scene_snapshot']\n        assert c['geometry_case_sha256']==digest(gcase) and c['word_ABI_sha256']==digest(b)\n        assert c['original_scene_binding_sha256']==b['original_scene_binding_sha256']\n        assert c['previous_geometry_accepted']==gcase['accepted_geometry_words_CPU_only']\n        assert c['previous_phase_accepted']==gcase['accepted_phase_budget_CPU_only']\n        assert c['retained_geometry_nodes_NOT_executed']==gcase['integer_operations']\n        count['retained_geometry_nodes_NOT_executed']+=c['retained_geometry_nodes_NOT_executed']\n        local={'q':0,'enc':0,'length':0,'sel':0}\n        for row,g,src,osrc in zip(c['paths'],gcase['sources'],b['sources'],scene['sources']):\n            count['sources']+=1\n            assert row['source_id']==g['source_id']==src['source_id']==osrc['id']\n            assert row['previous_geometry_accepted']==g['accepted_geometry_words_CPU_only']\n            assert row['previous_phase_accepted']==g['accepted_phase_budget_CPU_only']\n            if not g['accepted_geometry_words_CPU_only']:\n                assert not row['arithmetic_evaluated'] and not row['accepted_bridge_phase_CPU_only']\n                assert 'measurement' not in row and 'selector' not in row\n                count['geometry_stops']+=1;continue\n            assert row['arithmetic_evaluated'];sgn=g['direction_sign'];mi,di=g['mirror_owner'],g['terminal_owner']\n            def plane(owner):\n                t=next(t for t in b['triangles'] if t['owner']==owner)\n                return sum(map(number,t['vertices_uint32_hilo'][0][0]),F(0))\n            center=sgn*(2*plane(mi)-sum(map(number,src['origin_uint32_hilo'][0]),F(0))-plane(di))\n            assert q(row['length_center_BU_rational'])==center\n            assert integer(row['center_length_scaled_signed256_words'],256)==center*S\n            def original_plane(owner):\n                return F(scene['objects'][b['object_ids'][owner]]['vertices_world_BU'][0][0])\n            original=sgn*(2*original_plane(mi)-F(osrc['position_BU'][0])-original_plane(di))\n            original_cycles=original/F(scene['lambda_BU'])\n            assert q(row['original_length_BU_rational'])==original and q(row['original_cycles_rational'])==original_cycles\n            assert row['phase_reference_id']=='original-source-zero:'+b['original_scene_binding_sha256']+':'+osrc['id']\n            for node in row['length_integer_operations']:\n                x,y=map(lambda w:integer(w,512),node['inputs_signed512_words']);op=node['op']\n                assert op in ('sub','mul');expected=x-y if op=='sub' else x*y\n                assert integer(node['output_signed512_words'],512)==expected and -(1<<511)<=expected<(1<<511)\n                local['length']+=1\n            assert integer(row['length_integer_operations'][-1]['output_signed512_words'],512)==center*S\n            nodes=row['HOST_length_encoding_nodes'];assert len(nodes)==2\n            assert q(nodes[0]['input_rational'])==center\n            h=nearest(nodes[0]['output_uint32'],center)\n            assert q(nodes[1]['input_rational'])==center-h\n            low=nearest(nodes[1]['output_uint32'],center-h)\n            for node in nodes:assert q(node['rounding_delta_rational'])==number(node['output_uint32'])-q(node['input_rational'])\n            cast=abs(h+low-center);assert q(row['length_encoding_error_BU_rational'])==cast;local['enc']+=2\n            m=row['measurement'];wl=b['wavelength_uint32_hilo'];w=number(wl[0]);wc=sum(map(number,wl),F(0))\n            assert m['length_limb_uint32']==[n['output_uint32'] for n in nodes]\n            assert m['wavelength_uint32']==wl[0] and row['wavelength_uint32_hilo']==wl\n            assert row['quotient_uses_high32_explicit'] is True\n            assert q(row['quotient_wavelength_BU_rational'])==w and q(row['full_wavelength_center_BU_rational'])==wc\n            ops=m['operations'];assert len(ops)==5 and m['RN32_operations']==5\n            vals=[];deltas=[]\n            for node in ops:\n                x,y=map(q,node['inputs_rational']);op=node['op']\n                exact=x/y if op=='div' else x*y if op=='mul' else x-y if op=='sub' else x+y\n                v=nearest(node['output_uint32'],exact);delta=v-exact\n                assert q(node['rounding_delta_rational'])==delta;vals.append(v);deltas.append(delta);local['q']+=1\n            a0,p0,r0,r1,a1=vals\n            assert [list(map(q,n['inputs_rational'])) for n in ops]==[[h,w],[a0,w],[h,p0],[r0,low],[r1,w]]\n            observed=a0+a1;rn=(abs(deltas[1])+abs(deltas[2])+abs(deltas[3]))/w+abs(deltas[4])\n            signed=(-deltas[1]+deltas[2]+deltas[3])/w+deltas[4]\n            assert observed-(h+low)/w==signed\n            assert q(m['modeled_quotient_rational'])==observed and q(m['quotient_error_upper_rational'])==rn\n            assert m['quotient_limb_uint32']==[ops[0]['output_uint32'],ops[4]['output_uint32']]\n            encode=cast/w;lambda_charge=abs(center/w-center/wc);numeric=encode+rn+lambda_charge\n            assert q(row['length_encoding_charge_cycles'])==encode and q(row['quotient_RN_charge_cycles'])==rn\n            assert q(row['discarded_lambda_low_charge_cycles'])==lambda_charge\n            lo,hi=[F(x,S) for x in g['length_interval_scaled']];wr=F(b['wavelength_radius_scaled'],S)\n            cyc_lo,cyc_hi=lo/(wc+wr),hi/(wc-wr)\n            geom=8*max(abs(cyc_lo-original_cycles),abs(cyc_hi-original_cycles));total=geom+8*numeric\n            assert q(row['geometry_phase_bound_rad'])==geom==q(g['phase_error_bound_rad'])\n            assert q(row['composed_phase_bound_rad'])==total and q(row['new_numeric_phase_bound_rad'])==8*numeric\n            assert 8*abs(observed-original_cycles)<=total and row['phase_budget_rad']==g['phase_budget_rad']\n            sl,sh=min(cyc_lo,observed-numeric),max(cyc_hi,observed+numeric)\n            assert list(map(q,row['selector_requested_enclosure_cycles']))==[sl,sh]\n            radius=max(observed-sl,sh-observed);rr=radius*S;ceil=(rr.numerator+rr.denominator-1)//rr.denominator\n            host=row['HOST_selector_radius'];s=row['selector']\n            assert integer(host['radius_signed256_words'],256)==ceil\n            assert q(host['exact_radius_cycles_rational'])==radius and q(host['outward_inflation_cycles_rational'])==F(ceil,S)-radius\n            ends=[observed-F(ceil,S),observed,observed+F(ceil,S)]\n            ns=[(v+F(1,2))//1 for v in ends];ks=[(4*(v-ns[1])+F(1,2))//1 for v in ends]\n            admitted=len(set(ns))==1 and len(set(ks))==1\n            assert s['accepted_CPU_integer_selector_only']==admitted\n            assert s['quotient_uint32']==m['quotient_limb_uint32'] and s['radius_signed256_words']==host['radius_signed256_words']\n            assert integer(s['observed_cycles_signed256_words'],256)==observed*S\n            if admitted:\n                assert s['integer_turn']==ns[1] and s['quarter_index']==ks[1]\n                assert integer(s['residual_cycles_signed256_words'],256)==(observed-ns[1]-F(ks[1],4))*S\n            for node in s['operations']:\n                x,y=map(lambda w:integer(w,256),node['inputs_signed256_words']);op=node['op']\n                expected=x+y if op=='add' else x-y if op=='sub' else x>>y if op=='shr' else x<<y\n                assert integer(node['output_signed256_words'],256)==expected and -(1<<255)<=expected<(1<<255);local['sel']+=1\n            assert s['integer_operations']==len(s['operations'])\n            accepted=g['accepted_phase_budget_CPU_only'] and admitted and total<=q(g['phase_budget_rad'])\n            assert row['accepted_bridge_phase_CPU_only']==accepted\n            count['bridge_accepted_sources']+=int(accepted);count['original_source_phase_oracles']+=1\n        assert c['quotient_RN32_operations']==local['q'] and c['HOST_length_encoding_RN32_operations']==local['enc']\n        assert c['new_length_integer_operations']==local['length'] and c['selector_integer_operations']==local['sel']\n        for dest,key in [('quotient_RN32_nodes','q'),('HOST_length_RN32_nodes','enc'),('new_length_integer_nodes','length'),('selector_integer_nodes','sel')]:count[dest]+=local[key]\n        assert c['accepted_bridge_phase_CPU_only']==all(p['accepted_bridge_phase_CPU_only'] for p in c['paths'])\n        count['bridge_accepted_cases']+=int(c['accepted_bridge_phase_CPU_only'])\n    assert count['geometry_stops']==5 and count['original_source_phase_oracles']==9 and count['sources']==14\n    assert count['retained_geometry_nodes_NOT_executed']==1706 and count['quotient_RN32_nodes']==45 and count['HOST_length_RN32_nodes']==18\n    assert a['cases']['declared_radius_PASS']['previous_phase_accepted'] and not a['cases']['declared_radius_PASS']['accepted_bridge_phase_CPU_only']\n    assert q(a['cases']['lambda_transport_FAIL']['paths'][0]['discarded_lambda_low_charge_cycles'])>0\n    if r.get('independent_validation',{}).get('result'):assert count==r['independent_validation']['result']\n    return count\nr=json.loads((R/'coordinacion/respuestas/AXIAL-GEOMETRY-QUOTIENT-001-CODEX.json').read_bytes())\nprint(json.dumps(validate(r),sort_keys=True))\n",
