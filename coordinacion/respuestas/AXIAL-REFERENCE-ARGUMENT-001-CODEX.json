  "independent_validation_code": "import base64,hashlib,json,zlib\nfrom fractions import Fraction as F\nfrom pathlib import Path\nROOT=Path('.')\nREPORT='coordinacion/respuestas/AXIAL-REFERENCE-ARGUMENT-001-CODEX.json'\nS=1<<149\ndef sha(b):return hashlib.sha256(b).hexdigest()\ndef digest(x):return sha(json.dumps(x,sort_keys=True,separators=(',',':'),allow_nan=False).encode())\ndef rat(x):\n    assert type(x) is list and len(x)==2 and all(type(v) is int for v in x) and x[1]>0\n    return F(*x)\ndef raw(r):\n    run=r['test_run'];b=zlib.decompress(base64.b64decode(run['stdout_zlib_base64'],validate=True))\n    assert run['rc']==0 and len(b)==run['stdout_bytes'] and sha(b)==run['stdout_sha256']\n    return json.loads(b)\ndef word(w,bits,frac,expbits,bias):\n    assert type(w) is int and 0<=w<1<<bits\n    e=(w>>frac)&((1<<expbits)-1);m=w&((1<<frac)-1)\n    assert e!=(1<<expbits)-1\n    if e==0:\n        assert m==0\n        return F(0)\n    v=F((1<<frac)|m)*F(2)**(e-bias-frac)\n    return -v if w>>(bits-1) else v\ndef f32(w):return word(w,32,23,8,127)\ndef f64(w):return word(w,64,52,11,1023)\ndef sint(ws):\n    assert type(ws) is list and len(ws)==8 and all(type(v) is int and 0<=v<1<<32 for v in ws)\n    n=sum(v<<(32*i) for i,v in enumerate(ws))\n    return n-(1<<256) if ws[7]>>31 else n\ndef even(q):\n    n,d=q.numerator,q.denominator\n    a,r=divmod(n,d)\n    return a+int(2*r>d or (2*r==d and a%2==1))\ndef rn64(q):\n    if not q:return 0\n    sign=int(q<0);q=abs(q);e=q.numerator.bit_length()-q.denominator.bit_length()\n    if q<F(2)**e:e-=1\n    assert -1022<=e<=1023\n    m=even(q*F(2)**(52-e))\n    if m==(1<<53):m>>=1;e+=1\n    return (sign<<63)|((e+1023)<<52)|(m-(1<<52))\nPI0=F('3.14159265358979323846264338327950288419716939937510')\nPI1=F('3.14159265358979323846264338327950288419716939937511')\nTWOPI=0x401921fb54442d18\nconst=max(abs(f64(TWOPI)-2*PI0),abs(f64(TWOPI)-2*PI1))\nr=json.loads((ROOT/REPORT).read_bytes())\nfor n,h in r['code_doc_sha256'].items():assert sha((ROOT/n).read_bytes())==h,n\nprev=json.loads((ROOT/'coordinacion/respuestas/AXIAL-REFERENCE-QUOTIENT-001-CODEX.json').read_bytes())\norigin=json.loads((ROOT/'coordinacion/respuestas/AXIAL-GEOMETRY-UNIT-001-CODEX.json').read_bytes())\nq=raw(prev);old=raw(origin)['audit']['cases'];out=raw(r);a=out['audit']\ngeometry=raw(json.loads((ROOT/'coordinacion/respuestas/AXIAL-GEOMETRY-WORDS-001-CODEX.json').read_bytes()))['cases']\nbank={}\nfor c in old.values():\n    for p in c['paths']:\n        if 'argument_measurement' in p:\n            m=p['argument_measurement'];key=tuple(m['residual_signed256_words'])\n            assert key not in bank or digest(bank[key])==digest(m)\n            bank[key]=m\ncounts={'bindings':0,'sources':0,'original_reference_argument_oracles':0,'cached_graphs_verified_origin_SHA':0,\n        'argument_conversion_RN64_checks':0,'argument_multiply_RN64_checks':0,'new_synthetic_ABI_controls':0}\ndef check_math(m,n):\n    res=F(n,S);castword=rn64(res)\n    assert m['residual_signed256_words'] and sint(m['residual_signed256_words'])==n\n    assert m['conversion']['output_uint64']==castword\n    represented=f64(castword);outword=rn64(represented*f64(TWOPI));value=f64(outword)\n    assert m['argument_uint64']==outword and m['TWO_PI_uint64']==TWOPI\n    delta=value-represented*f64(TWOPI)\n    assert rat(m['operations'][0]['rounding_delta_rational'])==delta\n    assert [rat(x) for x in m['operations'][0]['inputs_rational']]==[represented,f64(TWOPI)]\n    assert m['operations'][0]['output_uint64']==outword\n    assert rat(m['observed_argument_rad_rational'])==value\n    charges={'residual_conversion':abs(f64(TWOPI))*abs(represented-res),\n             'constant_2pi':abs(res)*const,'multiply_RN64':abs(delta)}\n    assert {k:rat(v) for k,v in m['angle_error_charges_rad_rational'].items()}==charges\n    assert rat(m['angle_error_upper_rad_rational'])==sum(charges.values(),F(0))\n    counts['argument_conversion_RN64_checks']+=1;counts['argument_multiply_RN64_checks']+=1\n    return value,charges\nfor group,inputs in [('cases',q['audit']['cases']),('controls',q['controls'])]:\n    assert set(a[group])==set(inputs)\n    for name,c in a[group].items():\n        incoming=inputs[name]\n        assert c['reference_quotient_case_sha256']==digest(incoming)\n        assert c['scene_binding_sha256']==incoming['scene_binding_sha256']\n        assert c['source_order']==incoming['source_order']==[p['source_id'] for p in c['paths']]\n        counts['bindings']+=1;counts['sources']+=len(c['paths'])\n        if group=='cases':\n            scene=geometry[name]['scene_snapshot']\n            assert c['retained_closure_gates_UNCHANGED']==incoming['retained_closure_gates_UNCHANGED']\n        else:\n            scene=json.loads(json.dumps(geometry['positive']['scene_snapshot']))\n            scene['objects']['D']['mode_origin_BU'][0]=q['control_inputs'][name]['new_original_modepoint_X']\n        for p,pp in zip(c['paths'],incoming['paths']):\n            assert p['source_id']==pp['source_id'] and p['argument_available']==pp['accepted_reference_quotient_CPU_only']\n            if not p['argument_available']:\n                assert p['accepted_argument_CPU_only'] is False and 'measurement' not in p\n                continue\n            m=p['measurement'];n=sint(pp['selector']['residual_cycles_signed256_words'])\n            value,charges=check_math(m,n)\n            sig=p['argument_cache'];assert sig['cache_hit'] is True and p['argument_evaluated'] is False\n            assert sig['key']['residual_words']==m['residual_signed256_words']\n            assert sig['key']['origin_report_sha256']==r['code_doc_sha256']['coordinacion/respuestas/AXIAL-GEOMETRY-UNIT-001-CODEX.json']\n            assert sig['output_sha256']==digest(m)==digest(bank[tuple(m['residual_signed256_words'])])\n            assert all(r['code_doc_sha256'][k]==v for k,v in sig['key']['code_sha256'].items())\n            counts['cached_graphs_verified_origin_SHA']+=1\n          