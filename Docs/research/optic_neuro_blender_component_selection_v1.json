{
  "schema": "neuro3d.optic_neuro_blender.component_selection.v1",
  "date": "2026-10-08",
  "owner_goal": "Our own functional optical neural network inside Blender; reuse selected techniques without replacing or diverting Neuro3D objectives.",
  "application_name": "OpticNeuroBlender",
  "own_repository": "Agnuxo1/Neuro3D",
  "decision": "OWN_CORE_WITH_SELECTED_EXTERNAL_TECHNIQUES",
  "priority_order": [
    "Close own coherent neural forward and error chain from scene",
    "Reuse mesh/model preparation techniques when required by the optical component",
    "Adopt validated coherence/polarization/beam/wave-reference techniques",
    "Accelerate equivalent computation with exact/controlled geometry caching, spatial queries and coherent graph compilation",
    "Measure matched task/model/precision/output full cost before adoption"
  ],
  "component_choices": [
    {
      "source": "BlenderPhotonics",
      "use": "Mesh generation, unit/material association and scene-to-solver workflow",
      "scope": "Volumetric meshing only when required; no claim of accelerating the current surface-only circuit"
    },
    {
      "source": "Blender Optics Simulator",
      "use": "Optical component models, coherence, Jones/Gaussian/Fresnel and wave references",
      "scope": "Explicit adaptation to same input coherence/phase/detector semantics"
    },
    {
      "source": "Neuro3D own solver",
      "use": "Neural input encoding, trainable optical parameters, complete coherent propagation, readout and learning",
      "scope": "Remain authoritative for project semantics; no learned-matrix fallback introduced"
    },
    {
      "source": "BlenderPhotonics MMC/MCX",
      "use": "Optional statistical volumetric transport",
      "scope": "Not a replacement for coherent carrier fields; only if a neural task needs such media"
    }
  ],
  "integration_blockers": [
    {
      "id": "source_coherence",
      "finding": "BOS emits distinct src_id groups and its measurement adds different-source intensities. Neuro3D inputs are coherent.",
      "required_action": "Common-source modulated channels or explicitly equivalent mutual coherence and relative phases"
    },
    {
      "id": "path_completeness",
      "finding": "BOS tracer EPS1e-4, near-parallel threshold1e-9, aperture tolerance1e-3, power cutoff1e-4 and depth/segment limits",
      "required_action": "Preserve our exact/admissible contacts and explicit incompleteness; rigorous omitted-field bound before discard"
    },
    {
      "id": "detector_definition",
      "finding": "BOS common Jones frame restores intercepted beam power; this is not automatically modal coupling",
      "required_action": "Define integrated-power vs modal-projection detector before comparing"
    },
    {
      "id": "gpu_precision_and_scope",
      "finding": "BOS CuPy/MLX GPU module accelerates off-trace FFT; fast complex64\u22481e-6 is author claim, not a universal error bound",
      "required_action": "Start comparison at suitable precision, reject unexpected nonfinites, include transfers; actual hardware tests required"
    },
    {
      "id": "physical_regime",
      "finding": "Nominal Iris aperture D/lambda\u22484; ray-regime physical validity not established",
      "required_action": "Wave-reference convergence and explicit regime limits before physical fidelity claim"
    }
  ],
